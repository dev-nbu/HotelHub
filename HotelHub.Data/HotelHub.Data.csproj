<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <!-- изрични версии на транзитивни пакети (от SqlClient → Azure.Core):
         Pkcs 9.0.11 има уязвимост (NU1902/NU1903), System.Memory.Data 8.0.1 не е за net10.0.
         При ъпгрейд на EF Core да се провери дали още са нужни. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageReference Include="System.Memory.Data" Version="10.0.14" />
  </ItemGroup>

</Project>
